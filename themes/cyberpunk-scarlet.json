{
  "base": "dark",
  "tokens": {
    "--background": "#101116",
    "--editor-surface": "#101116",
    "--muted": "#012112",
    "--popover": "#140007",
    "--sidebar": "#0a0b0e",
    "--accent": "#400e23",
    "--muted-foreground": "#e35783",
    "--foreground": "#ffffff",
    "--popover-foreground": "#ffffff",
    "--primary": "#ff0055",
    "--primary-foreground": "#00140b",
    "--accent-foreground": "#ffffff",
    "--border": "#370e20",
    "--ring": "#00ffc8",
    "--worktree-sidebar-active": "#ff005528",
    "--sidebar-foreground": "#ec779b",
    "--sidebar-border": "#32091a",
    "--host-badge": "#00ffc8",
    "--host-badge-foreground": "#000807",
    "--tab-bar": "#101116",
    "--tab-active": "#101116",
    "--tab-inactive": "#101116",
    "--tab-inactive-foreground": "#d54a78",
    "--tab-active-foreground": "#ff5680",
    "--tab-active-indicator": "#ff0055",
    "--split-divider": "#370e20",
    "--split-divider-hover": "#ff0055",
    "--text-link": "#00ffc8",
    "--chat-muted-foreground": "#e75c87",
    "--chat-selection": "#390e21",
    "--diff-added-background": "#00ff8427",
    "--diff-added": "#00ffc8",
    "--diff-added-emphasis": "#00ff8427",
    "--diff-removed-background": "#ff174534",
    "--diff-removed": "#ff2055",
    "--diff-removed-emphasis": "#ff174534",
    "--git-decoration-added": "#00ffc8",
    "--git-decoration-modified": "#00c3ff",
    "--git-decoration-deleted": "#ff004c",
    "--git-decoration-renamed": "#00ffc8",
    "--git-decoration-untracked": "#00ffc8",
    "--git-decoration-copied": "#00ffc8",
    "--git-decoration-ignored": "#94455c"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6766b3",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff004c"
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#d57bff"
      }
    },
    {
      "name": "Control keywords",
      "scope": [
        "keyword.control"
      ],
      "settings": {
        "foreground": "#00b0ff"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.tag",
        "punctuation.definition.tag",
        "punctuation.section.embedded",
        "keyword.other.template",
        "keyword.other.substitution"
      ],
      "settings": {
        "foreground": "#00b0ff"
      }
    },
    {
      "name": "Color constants",
      "scope": [
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#00b0ff"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml"
      ],
      "settings": {
        "foreground": "#ff5680"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "variable.function",
        "support.function",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#00b0ff"
      }
    },
    {
      "name": "Methods",
      "scope": [
        "entity.name.method.js"
      ],
      "settings": {
        "foreground": "#6095ff",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Constructors",
      "scope": [
        "variable.function.constructor"
      ],
      "settings": {
        "foreground": "#6095ff"
      }
    },
    {
      "name": "Support variables",
      "scope": [
        "support.other.variable"
      ],
      "settings": {
        "foreground": "#00ff9c"
      }
    },
    {
      "name": "Constants and numbers",
      "scope": [
        "constant.numeric",
        "constant.language",
        "support.constant",
        "constant.character",
        "constant.escape",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#fffc58"
      }
    },
    {
      "name": "Units and other keywords",
      "scope": [
        "keyword.other",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#ff5680"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "constant.other.symbol",
        "constant.other.key",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#76c1ff",
        "fontStyle": ""
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name",
        "support.type",
        "support.class",
        "support.type.sys-types",
        "support.other.namespace.php",
        "meta.use.php"
      ],
      "settings": {
        "foreground": "#00ff9c"
      }
    },
    {
      "name": "CSS property names",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.scss",
        "support.type.property-name.less"
      ],
      "settings": {
        "foreground": "#98e3ff"
      }
    },
    {
      "name": "Modules and imports",
      "scope": [
        "entity.name.module.js",
        "variable.import.parameter.js",
        "variable.other.class.js"
      ],
      "settings": {
        "foreground": "#ff5680"
      }
    },
    {
      "name": "Language variables",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#ff5680",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#ee6dff"
      }
    },
    {
      "name": "HTML attributes",
      "scope": [
        "entity.other.attribute-name.html"
      ],
      "settings": {
        "foreground": "#00ff9c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS classes",
      "scope": [
        "entity.other.attribute-name.class"
      ],
      "settings": {
        "foreground": "#00ff9c"
      }
    },
    {
      "name": "Inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#00ffc8"
      }
    },
    {
      "name": "Deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#ff004c"
      }
    },
    {
      "name": "Changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#d57bff"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#00ffc8"
      }
    },
    {
      "name": "Escape characters",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#00ffc8"
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#d57bff"
      }
    },
    {
      "name": "Markdown text",
      "scope": [
        "text.html.markdown"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#76c1ff",
        "fontStyle": ""
      }
    },
    {
      "name": "Heading marks",
      "scope": [
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#00ff9c"
      }
    },
    {
      "name": "Inline code",
      "scope": [
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#d57bff"
      }
    },
    {
      "name": "Inline code punctuation",
      "scope": [
        "punctuation.definition.raw.markdown"
      ],
      "settings": {
        "foreground": "#6766b3"
      }
    },
    {
      "name": "Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#ff5680",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#ff5680",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Underline",
      "scope": [
        "markup.underline"
      ],
      "settings": {
        "foreground": "#ff5680",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Links",
      "scope": [
        "string.other.link"
      ],
      "settings": {
        "foreground": "#00ff9c"
      }
    },
    {
      "name": "Link titles",
      "scope": [
        "string.other.link.title.markdown"
      ],
      "settings": {
        "foreground": "#00ff9c"
      }
    },
    {
      "name": "Link descriptions",
      "scope": [
        "string.other.link.description.title.markdown"
      ],
      "settings": {
        "foreground": "#00ff9c"
      }
    },
    {
      "name": "Link references",
      "scope": [
        "constant.other.reference.link.markdown"
      ],
      "settings": {
        "foreground": "#fffc58"
      }
    },
    {
      "name": "Code blocks",
      "scope": [
        "markup.raw.block"
      ],
      "settings": {
        "foreground": "#d57bff"
      }
    },
    {
      "name": "Separators",
      "scope": [
        "meta.separator"
      ],
      "settings": {
        "foreground": "#6766b3",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Tables",
      "scope": [
        "markup.table"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "Quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator"
      ],
      "settings": {
        "foreground": "#d57bff"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant"
      ],
      "settings": {
        "foreground": "#fffc58"
      }
    },
    {
      "name": "Log info",
      "scope": [
        "token.info-token"
      ],
      "settings": {
        "foreground": "#00c3ff"
      }
    },
    {
      "name": "Log warnings",
      "scope": [
        "token.warn-token"
      ],
      "settings": {
        "foreground": "#ff9100"
      }
    },
    {
      "name": "Log errors",
      "scope": [
        "token.error-token"
      ],
      "settings": {
        "foreground": "#ff004c"
      }
    },
    {
      "name": "Log debug",
      "scope": [
        "token.debug-token"
      ],
      "settings": {
        "foreground": "#d57bff"
      }
    }
  ]
}
